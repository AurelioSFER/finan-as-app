# Copia este ficheiro para .env.local e preenche com os dados do teu projeto Supabase
# (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Leitura de prints de extratos (opcional).
# SEM o prefixo NEXT_PUBLIC_: esta chave fica no servidor e nunca vai para o browser.
# Sem ela, o botão de anexar print responde 501 e o resto da app funciona na mesma.
ANTHROPIC_API_KEY=sk-ant-...
